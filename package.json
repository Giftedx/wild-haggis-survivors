{
  "name": "wild-haggis-survivors",
  "version": "2.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "serialize-javascript": "7.0.5"
  },
  "scripts": {
    "dev": "vite --port 3000 --open",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint src e2e playwright.config.ts vite.config.ts eslint.config.mjs",
    "flash-budget": "node scripts/check-flash-budget.mjs",
    "budget": "node scripts/check-bundle-budget.mjs",
    "loc-report": "node scripts/report-loc.mjs",
    "mechanic:e2e-inventory": "node scripts/report-mechanic-e2e-coverage.mjs",
    "palette": "node scripts/check-palette-drift.mjs",
    "ci": "npm run lint && npm test && npm run build && npm run budget && npm run flash-budget && npm run loc-report",
    "test:e2e": "playwright test",
    "test:e2e:firefox": "playwright test --project=firefox-desktop",
    "test:e2e:webkit": "playwright test --project=webkit-desktop",
    "test:e2e:cross-browser": "playwright test --project=firefox-desktop --project=webkit-desktop",
    "ci:ui": "npm run ci && playwright test --project=chromium-desktop e2e/smoke.spec.ts e2e/main-menu-dom-focus.spec.ts e2e/settings-dom-focus.spec.ts e2e/game-over-dom-focus.spec.ts",
    "ci:all": "npm run ci && npm run test:e2e",
    "npm:test:cloud": "cd cloudflare && npm test"
  },
  "dependencies": {
    "phaser": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tweakpane/core": "^2.0.5",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.2.0",
    "eventemitter3": "^5.0.0",
    "tweakpane": "^4.0.5",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^6.4.2",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3.2.4"
  }
}
